digraph ERD {
 graph [rankdir=LR, bgcolor="#f8fafc", pad="0.45", nodesep="0.7", ranksep="1.2", splines=polyline, overlap=false, outputorder=nodesfirst, label="Requests and receiving", labelloc=t, fontsize=22, fontname="Arial", fontcolor="#22304d"];
